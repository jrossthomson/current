
// nextflow.config
// Enable the Docker executor for all processes
docker {
    enabled = true
    // Optional: Add run options for Docker (e.g., to ensure consistent user permissions)
    // This makes sure the container runs as your current user/group ID
    // (important for file permissions if you were mounting volumes)
    runOptions = '-u \$(id -u):\$(id -g)'
}

// Global process configuration (can be overridden by individual processes)
process {
    executor = 'local' // Explicitly set the executor to Docker
}
